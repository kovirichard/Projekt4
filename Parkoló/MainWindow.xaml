<Window x:Class="Parkoló.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Parkoló"
        mc:Ignorable="d"
        Title="Parkoló Kezelő"
        MinHeight="450" MinWidth="800" Height="450" Width="800" Icon="/Images/icon.ico">
    <Grid x:Name="mainGrid" Background="DodgerBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" BorderThickness="0,0,2,0" BorderBrush="CadetBlue" Background="SteelBlue">
            <UniformGrid Columns="1" Margin="0,20">
                <Button Style="{DynamicResource FomenuGomb}" x:Name="Járművek" Content="Járművek" Click="Jarmuvek_Click"/>
                <Button Style="{DynamicResource FomenuGomb}" x:Name="Parkolók" Content="Parkolók" Click="Parkolok_Click"/>
                <Button Style="{DynamicResource FomenuGomb}" x:Name="Események" Content="Események" Click="Esemenyek_Click"/>
                <Button Style="{DynamicResource FomenuGomb}" x:Name="Tarifák" Content="Tarifák" Click="Tarifak_Click"/>
                <Button Style="{DynamicResource FomenuGomb}" x:Name="Tranzakciók" Content="Tranzakciók" Click="Tranzakciok_Click"/>
                <Button Style="{DynamicResource FomenuGomb}" x:Name="Statisztikák" Content="Statisztikák" Click="Statisztikak_Click"/>
            </UniformGrid>
        </Border>
    </Grid>
</Window>